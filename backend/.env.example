# Environment (development / production)
ENVIRONMENT=development

# Server bind settings
HOST=0.0.0.0
PORT=8000

# MongoDB Atlas connection string and database name
# Replace with your actual MongoDB Atlas connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=pantry_db

# Allowed CORS origins (comma-separated list, e.g., for Flutter Web or local frontend testing)
# In development, you can use '*' or list explicit origins like http://localhost:8080,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
